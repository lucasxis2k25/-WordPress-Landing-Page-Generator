# ============================================================
# .env.example — copie para .env e preencha com suas chaves
# cp .env.example .env
# ============================================================


# ------------------------------------------------------------
# WordPress / WooCommerce REST API
# ------------------------------------------------------------
WP_USERNAME=seu_usuario_wp
WP_APP_PASSWORD=sua_application_password
WP_BASE_URL=https://seu-site.com


# ------------------------------------------------------------
# IA — escolha UMA das opções abaixo
# ------------------------------------------------------------

# Opção 1: Google Gemini (padrão)
GEMINI_API_KEY=sua_chave_gemini

# Opção 2: Anthropic Claude
# ANTHROPIC_API_KEY=sua_chave_claude
# AI_PROVIDER=claude

# Se ambas as chaves estiverem definidas, AI_PROVIDER decide qual usar.
# Valores válidos: gemini | claude   (padrão: gemini)
# AI_PROVIDER=gemini
